# Copy to .env (PowerShell: copy .env.example .env). Never commit .env.

# SQLite path is resolved relative to backend/, wherever the server is started from.
DATABASE_URL=sqlite:///./storage/app.db
# PostgreSQL works with no code changes (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://portal:portal@localhost:5432/portal

# Signs login tokens. Replace with a long random value for anything but local use.
JWT_SECRET=change-me-local-development-only-secret
JWT_EXPIRE_MINUTES=480

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seeded demo account, created by: python -m scripts.seed
DEMO_USER_EMAIL=recruiter@demo.com
DEMO_USER_PASSWORD=Demo@12345
